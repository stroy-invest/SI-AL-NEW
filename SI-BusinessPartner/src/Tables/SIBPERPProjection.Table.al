    }

    keys
    {
        // Це й забезпечує контракт:
        // одна роль -> максимум одна projection.
        key(PK; "Role Code")
        {
            Clustered = true;
        }
    }

    trigger OnDelete()
    var
        ProjectionBank: Record "SI BP ERP Proj. Bank";
    begin
        if Status = Status::Materialized then
            Error(
                'Матеріалізовану ERP-проєкцію видаляти не можна.');

        ProjectionBank.SetRange(
            "Role Code",
            "Role Code");

        ProjectionBank.DeleteAll(true);
    end;
}