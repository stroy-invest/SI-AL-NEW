        field(2; "Business Partner No."; Code[20])
        {
            Caption = 'Контрагент';
            TableRelation = "SI Business Partner"."No.";
        }

        field(3; "Business Partner Name"; Text[250])
        {
            Caption = 'Назва контрагента';
        }

        field(4; "Role Type"; Enum "SI BP Role Type")
        {
            Caption = 'Тип ролі';
